{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taric.dev/schemas/v1/core.schema.json",
  "title": "Taric Core Contracts v1",
  "description": "Phase 1 单机首发领域合同。所有合同都是严格的：缺失字段、额外字段、格式错误和非法枚举一律拒绝。",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uuidList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trustLevel": {
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "recallStatus": {
      "description": "记忆生命周期状态。retracted/superseded/archived/stale/expired 必须被排除出当前 recall。",
      "enum": [
        "active",
        "draft",
        "verified",
        "proposed",
        "stale",
        "retracted",
        "superseded",
        "archived",
        "expired"
      ]
    },
    "decisionLayer": {
      "enum": [
        "edge",
        "network",
        "origin",
        "unknown"
      ]
    },
    "originOutcome": {
      "enum": [
        "reached",
        "not_reached",
        "unknown"
      ]
    },
    "originReached": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "nullableString": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "actionMode": {
      "enum": [
        "llm_recommend",
        "authorized_autonomous",
        "host_hitl"
      ]
    },
    "artifactReference": {
      "type": "object",
      "description": "宿主管理的 Artifact 引用。Taric 只保存引用元数据，不保存内容。",
      "required": [
        "host_ref"
      ],
      "properties": {
        "host_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "location": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "host_id",
        "producer_id",
        "source_kind"
      ],
      "properties": {
        "host_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_kind": {
          "enum": [
            "host",
            "tool",
            "worker",
            "reviewer",
            "import"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/uuidList"
        },
        "worker_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "attempt_ref": {
          "$ref": "#/$defs/uuid"
        },
        "dispatch_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "recordBase": {
      "type": "object",
      "required": [
        "id",
        "schema_version",
        "engagement_id",
        "created_at",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "engagement_id": {
          "$ref": "#/$defs/uuid"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "coreManagedFields": {
      "description": "由 Core writer 分配或维护的字段。调用者不得设置；schema 允许它们存在，只是为了让权威记录可以被校验。",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "trust_level": {
          "$ref": "#/$defs/trustLevel"
        },
        "display_id": {
          "type": "string",
          "pattern": "^TAR-[0-9]{6,}$"
        },
        "commit_seq": {
          "type": "integer",
          "minimum": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "review_ref": {
          "$ref": "#/$defs/uuid"
        },
        "recall_excluded": {
          "type": "boolean"
        },
        "stale_reason": {
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "superseded_by": {
          "$ref": "#/$defs/uuid"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence_claimed": {
          "type": "boolean"
        }
      }
    },
    "scope": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "allowed_targets",
            "excluded_targets",
            "rules_of_engagement_ref"
          ],
          "properties": {
            "allowed_targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "excluded_targets": {
              "$ref": "#/$defs/stringList"
            },
            "rules_of_engagement_ref": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "valid_from": {
              "$ref": "#/$defs/timestamp"
            },
            "valid_until": {
              "$ref": "#/$defs/timestamp"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "engagement": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "name",
            "scope_ref",
            "status"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "scope_ref": {
              "$ref": "#/$defs/uuid"
            },
            "status": {
              "enum": [
                "active",
                "paused",
                "completed",
                "archived"
              ]
            },
            "action_mode": {
              "$ref": "#/$defs/actionMode"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "resource": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "asset_type",
            "identity",
            "revision"
          ],
          "properties": {
            "kind": {
              "const": "resource"
            },
            "asset_type": {
              "enum": [
                "host",
                "domain",
                "service",
                "web_app",
                "route",
                "endpoint",
                "page",
                "static_asset",
                "workflow",
                "dataset",
                "feature",
                "bundle",
                "other"
              ]
            },
            "identity": {
              "type": "object",
              "minProperties": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "content_hash": {
              "$ref": "#/$defs/sha256"
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifactReference"
              }
            },
            "tags": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "observation": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "resource_ref",
            "observed_at",
            "statement",
            "artifact_refs"
          ],
          "properties": {
            "resource_ref": {
              "$ref": "#/$defs/uuid"
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "statement": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifactReference"
              }
            },
            "limitations": {
              "$ref": "#/$defs/stringList"
            },
            "status": {
              "$ref": "#/$defs/recallStatus"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "relation": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "from_ref",
            "predicate",
            "to_ref",
            "version"
          ],
          "properties": {
            "from_ref": {
              "$ref": "#/$defs/uuid"
            },
            "predicate": {
              "enum": [
                "calls",
                "defines",
                "reads",
                "writes",
                "returns",
                "belongs_to",
                "protects",
                "filters",
                "authenticates",
                "permits",
                "denies",
                "routes_to",
                "depends_on"
              ]
            },
            "to_ref": {
              "$ref": "#/$defs/uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "source_observation_refs": {
              "$ref": "#/$defs/uuidList"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "claim": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "proposition",
            "status",
            "evidence_refs",
            "limitations"
          ],
          "properties": {
            "proposition": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "status": {
              "enum": [
                "proposed",
                "supported",
                "contradicted",
                "inconclusive",
                "stale",
                "retracted",
                "superseded"
              ]
            },
            "evidence_refs": {
              "$ref": "#/$defs/uuidList"
            },
            "observation_refs": {
              "$ref": "#/$defs/uuidList"
            },
            "limitations": {
              "$ref": "#/$defs/stringList"
            },
            "applicable_scope_ref": {
              "$ref": "#/$defs/uuid"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "characters": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "workItem": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "title",
            "status",
            "acceptance_criteria"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "status": {
              "enum": [
                "queued",
                "claimed",
                "in_progress",
                "checkpointed",
                "blocked",
                "completed",
                "failed",
                "cancelled",
                "lost"
              ]
            },
            "acceptance_criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "goal": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "acceptance": {
              "$ref": "#/$defs/stringList"
            },
            "depends_on": {
              "$ref": "#/$defs/uuidList"
            },
            "risk_class": {
              "enum": [
                "informational",
                "finding",
                "action"
              ]
            },
            "risk_budget": {
              "$ref": "#/$defs/budget"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "artifact_ref",
            "observed_at",
            "limitations"
          ],
          "properties": {
            "artifact_ref": {
              "$ref": "#/$defs/artifactReference"
            },
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "limitations": {
              "$ref": "#/$defs/stringList"
            },
            "resource_ref": {
              "$ref": "#/$defs/uuid"
            },
            "statement": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "finding": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "title",
            "claim_refs",
            "evidence_refs",
            "review_ref",
            "status"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "claim_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/uuid"
              }
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/uuid"
              }
            },
            "review_ref": {
              "$ref": "#/$defs/uuid"
            },
            "status": {
              "enum": [
                "draft",
                "verified",
                "retracted",
                "stale"
              ]
            },
            "severity": {
              "enum": [
                "informational",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "limitations": {
              "$ref": "#/$defs/stringList"
            },
            "applicable_scope_ref": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "coverageCell": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "resource_ref",
            "test_category",
            "status",
            "limitations"
          ],
          "properties": {
            "resource_ref": {
              "$ref": "#/$defs/uuid"
            },
            "resource_revision_ref": {
              "$ref": "#/$defs/uuid"
            },
            "test_category": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "identity_ref": {
              "$ref": "#/$defs/uuid"
            },
            "operation": {
              "type": "string"
            },
            "parameter": {
              "type": "string"
            },
            "conditions": {
              "$ref": "#/$defs/stringList"
            },
            "status": {
              "enum": [
                "not_tested",
                "queued",
                "in_progress",
                "tested_no_observation",
                "positive",
                "inconclusive",
                "blocked",
                "blocked_by_control",
                "not_applicable"
              ]
            },
            "tested_at": {
              "$ref": "#/$defs/timestamp"
            },
            "limitations": {
              "$ref": "#/$defs/stringList"
            },
            "evidence_refs": {
              "$ref": "#/$defs/uuidList"
            },
            "control_observation_ref": {
              "$ref": "#/$defs/uuid"
            },
            "origin_reached": {
              "$ref": "#/$defs/originReached"
            },
            "external_result_state": {
              "enum": [
                "ingested",
                "pending",
                "unavailable"
              ]
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "negativeObservation": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "statement",
            "method",
            "tested_resource_refs",
            "conditions",
            "limitations",
            "bounded"
          ],
          "properties": {
            "statement": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "method": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "baseline_ref": {
              "$ref": "#/$defs/uuid"
            },
            "control_ref": {
              "$ref": "#/$defs/uuid"
            },
            "tested_resource_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/uuid"
              }
            },
            "identity_ref": {
              "$ref": "#/$defs/uuid"
            },
            "operation": {
              "type": "string"
            },
            "parameter": {
              "type": "string"
            },
            "conditions": {
              "$ref": "#/$defs/stringList"
            },
            "tested_at": {
              "$ref": "#/$defs/timestamp"
            },
            "evidence_refs": {
              "$ref": "#/$defs/uuidList"
            },
            "limitations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "bounded": {
              "const": true
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "proposal": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "subject_type",
            "content_hash",
            "status",
            "base_version"
          ],
          "properties": {
            "subject_type": {
              "enum": [
                "observation",
                "resource",
                "relation",
                "claim",
                "work_item",
                "evidence",
                "finding",
                "coverage",
                "checkpoint",
                "action_recommendation"
              ]
            },
            "content_hash": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "enum": [
                "pending",
                "rejected",
                "admitted",
                "needs_evidence"
              ]
            },
            "base_version": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_refs": {
              "$ref": "#/$defs/uuidList"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "review": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "proposal_ref",
            "reviewer_id",
            "reviewer_kind",
            "input_hash",
            "verdict"
          ],
          "properties": {
            "proposal_ref": {
              "$ref": "#/$defs/uuid"
            },
            "reviewer_id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "reviewer_kind": {
              "enum": [
                "deterministic",
                "model",
                "reviewer"
              ]
            },
            "input_hash": {
              "$ref": "#/$defs/sha256"
            },
            "verdict": {
              "enum": [
                "pass",
                "reject",
                "needs_evidence",
                "defer"
              ]
            },
            "policy_digest": {
              "$ref": "#/$defs/sha256"
            },
            "rubric_hash": {
              "$ref": "#/$defs/sha256"
            },
            "evidence_snapshot_hash": {
              "$ref": "#/$defs/sha256"
            },
            "limitations": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "protectiveControl": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "$ref": "#/$defs/coreManagedFields"
        },
        {
          "type": "object",
          "required": [
            "name",
            "layer",
            "resource_ref"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "layer": {
              "$ref": "#/$defs/decisionLayer"
            },
            "resource_ref": {
              "$ref": "#/$defs/uuid"
            },
            "control_kind": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "control_type": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "authMetadata": {
      "description": "只允许非秘密的认证/会话元数据。凭据和 token 不属于这里。",
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "maxLength": 256
        },
        "principal_class": {
          "type": "string",
          "maxLength": 256
        },
        "session_ref": {
          "type": "string",
          "maxLength": 256
        },
        "session_state": {
          "type": "string",
          "maxLength": 256
        },
        "authentication_method": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "controlObservation": {
      "allOf": [
        {
